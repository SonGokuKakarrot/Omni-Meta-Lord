{
  "manifest_version": 3,
  "name": "Omni Meta Lord",
  "version": "1.0.0",
  "description": "Maximum mic gain for Messenger, Facebook & Instagram web calls. Loud, clear, raw voice on every call.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.messenger.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Omni Meta Lord"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.messenger.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.messenger.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
